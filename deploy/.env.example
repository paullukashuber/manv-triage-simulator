# Auf dem Server nach /opt/manv-triage-app/.env kopieren, Werte setzen, chmod 600 .env.
# Leere Pflichtwerte lassen docker compose mit einer Fehlermeldung abbrechen.
# Erzeugen mit: openssl rand -hex 24
POSTGRES_PASSWORD=
# Erzeugen mit: openssl rand -base64 48
AUTH_SECRET=
PUBLIC_URL=https://triage.plhuber.de
SEED_PUBLISH=false
IMAGE_TAG=latest
